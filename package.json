{
  "name": "contgenerator",
  "version": "2.0.0",
  "description": "Antigravity Content Swarm core library and parser (SEMrush level)",
  "main": "dist/parser.js",
  "types": "dist/parser.d.ts",
  "bin": {
    "contgenerator": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsup src/cli.ts src/parser.ts --watch",
    "build": "tsup src/cli.ts src/parser.ts --format cjs --dts --minify",
    "test": "vitest run",
    "parse-content": "contgenerator build"
  },
  "keywords": [
    "content",
    "generator",
    "ai",
    "antigravity",
    "seo",
    "markdown"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@postiz/node": "^1.0.8",
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.7",
    "openai": "^6.34.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/marked": "^6.0.0",
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.5"
  }
}
